# .env.example — copy to .env and fill in your credentials. Never commit .env.

# LLM
LLM_API_KEY=
# stub = canned responses (no API calls); real providers are wired in a later milestone
LLM_MODE=stub

# Source DB (synthetic legacy clinic DB from source_db/)
SOURCE_DB_URL=postgresql://legacy:legacy@localhost:5433/legacy_db

# Snowflake target (if using Snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION_TARGET

# BigQuery target (if using BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT_ID=

# LangFuse Observability (tracing is skipped when the keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Confidence threshold
CONFIDENCE_THRESHOLD=0.80

# Where runs/, audit/, checkpoints/ and review/queue/ are written (default: project root)
MIGRATION_WORKDIR=
